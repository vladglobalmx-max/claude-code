{
  "name": "@impulso/template-library",
  "version": "0.1.0",
  "private": true,
  "description": "Templates Foundation oficial de Impulso Platform: catálogo de plantillas reutilizable por cualquier módulo (Sticker Builder, Planner Builder, Coloring Book Builder...). Un Template es un Project completo + metadata de catálogo, independiente del módulo que lo consuma.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@impulso/document-schema": "workspace:*",
    "@impulso/engine": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.5",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
