{
  "name": "@impulso/print-engine",
  "version": "0.2.0",
  "private": true,
  "description": "Print Engine oficial de Impulso Platform: PrintJob, unidades físicas/PPI, boxes (trim/bleed/safe/media), naming determinista, estimación de memoria, Preflight, pipeline de raster físico y exportación PNG/PDF aplanado de alta resolución — reutilizable por cualquier Builder. Ver ADRs de Epic 9 (Fases 9.1-9.2).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@impulso/document-schema": "workspace:*",
    "@impulso/export-engine": "workspace:*",
    "@impulso/renderer-konva": "workspace:*",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.5",
    "jsdom": "^25.0.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
