{
  "name": "@impulso/export-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Export Engine oficial de Impulso Platform: produce archivos finales (PNG/SVG) a partir del Document Schema. SVG es independiente de Konva; PNG reutiliza @impulso/renderer-konva vía un Stage headless (ver ADR-0012).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@impulso/document-schema": "workspace:*",
    "@impulso/renderer-konva": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.5",
    "jsdom": "^25.0.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
