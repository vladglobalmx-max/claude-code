{
  "name": "@impulso/sticker-builder",
  "version": "0.17.2",
  "private": true,
  "description": "Editor de Sticker Builder. Primer módulo construido sobre Impulso Engine + el Renderer Konva. Desde Fase 9.4, incluye el flujo real de exportación a producción sobre @impulso/print-engine; Fase 9.5 endureció ese flujo. Desde Fase 4.2, es además el primer producto comercial real y empaquetable (\"Impulso Sticker Builder Professional\") — manifest/capabilities reales, build:commercial reproducible, backup de proyectos, launchers offline verificados.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vite build && playwright test",
    "typecheck": "tsc --noEmit",
    "validate:manifest": "node scripts/validate-commercial-manifest.mjs",
    "build:commercial": "node scripts/build-commercial.mjs"
  },
  "dependencies": {
    "@impulso/asset-library": "workspace:*",
    "@impulso/capabilities": "workspace:*",
    "@impulso/commercial-schema": "workspace:*",
    "@impulso/document-schema": "workspace:*",
    "@impulso/engine": "workspace:*",
    "@impulso/export-engine": "workspace:*",
    "@impulso/print-engine": "workspace:*",
    "@impulso/project-library": "workspace:*",
    "@impulso/renderer-konva": "workspace:*",
    "@impulso/template-library": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^2.0.5",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "konva": "^9.3.14",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vitest": "^2.0.5"
  }
}
