// GLOBAL QUOTE — Modulo 1 (Cimientos): roles, permisos, lineas de negocio y usuarios.
// Ver docs/ARCHITECTURE.md secciones 4 y 5 para el modelo completo planeado.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleCode {
  SUPER_ADMIN
  DIRECCION_GENERAL
  ADMINISTRACION
  GERENTE_VENTAS
  VENDEDOR
  MARKETING
  CONSULTA
}

enum FolioNumberingMode {
  ANNUAL
  CONTINUOUS
}

enum Currency {
  MXN
  USD
}

enum ProductType {
  STANDARD
  CONFIGURABLE
  PROJECT
  KIT
  COMBO
  SERVICE
  INSTALLATION
  FREIGHT
  PROMOTIONAL
  CUSTOM
  BACKORDER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

model BusinessUnit {
  id                 String             @id @default(uuid()) @db.Uuid
  code               String             @unique
  name               String
  legalName          String?            @map("legal_name")
  taxId              String?            @map("tax_id")
  address            String?
  logoUrl            String?            @map("logo_url")
  colorPrimary       String?            @map("color_primary")
  colorSecondary     String?            @map("color_secondary")
  minMarginDefault   Decimal?           @map("min_margin_default") @db.Decimal(5, 2)
  folioNumberingMode FolioNumberingMode @default(ANNUAL) @map("folio_numbering_mode")
  active             Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  userBusinessUnits UserBusinessUnit[]
  categories        Category[]
  products          Product[]
  priceLists        PriceList[]
  customers         Customer[]
  sequenceSettings  SequenceSettings[]
  quotations        Quotation[]

  @@map("business_units")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  passwordHash        String    @map("password_hash")
  fullName            String    @map("full_name")
  folioCode           String?   @map("folio_code")
  roleId              String    @map("role_id") @db.Uuid
  active              Boolean   @default(true)
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  discountLimitPct    Decimal?  @map("discount_limit_pct") @db.Decimal(5, 2)
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  role              Role               @relation(fields: [roleId], references: [id])
  userBusinessUnits UserBusinessUnit[]
  assignedCustomers Customer[]
  quotationsAsSeller      Quotation[]
  quotationStatusChanges  QuotationStatusHistory[]
  quotationApprovalsRequested QuotationApproval[] @relation("QuotationApprovalRequestedBy")
  quotationApprovalsDecided   QuotationApproval[] @relation("QuotationApprovalApprover")
  quotationVersionsCreated    QuotationVersion[]

  @@map("users")
}

model UserBusinessUnit {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  businessUnitId String   @map("business_unit_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@unique([userId, businessUnitId])
  @@map("user_business_units")
}

// ---------------------------------------------------------------------------
// Modulo 3 (Catalogo, alcance basico): categorias, productos, costos con
// vigencia y listas de precios. Ver docs/ARCHITECTURE.md §5.2 y §8.1.
// Fuera de este alcance por ahora: imagenes/documentos, kits/combos reales,
// precios por volumen/cliente (vienen despues, sin requerir migracion nueva).
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])
  parent       Category?    @relation("CategoryToSubcategory", fields: [parentId], references: [id])
  subcategories Category[]  @relation("CategoryToSubcategory")
  products     Product[]

  @@unique([businessUnitId, name])
  @@map("categories")
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  businessUnitId     String        @map("business_unit_id") @db.Uuid
  categoryId         String?       @map("category_id") @db.Uuid
  internalSku        String        @unique @map("internal_sku")
  supplierSku        String?       @map("supplier_sku")
  barcode            String?
  name               String
  shortDescription   String?       @map("short_description")
  technicalDescription String?     @map("technical_description")
  type               ProductType   @default(STANDARD)
  status             ProductStatus @default(ACTIVE)
  uom                String        @default("PZA")
  minOrderQty        Int           @default(1) @map("min_order_qty")
  leadTimeDays       Int?          @map("lead_time_days")
  warranty           String?
  countryOfOrigin    String?       @map("country_of_origin")
  purchaseCurrency   Currency      @default(MXN) @map("purchase_currency")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  deletedAt          DateTime?     @map("deleted_at")

  businessUnit    BusinessUnit     @relation(fields: [businessUnitId], references: [id])
  category        Category?        @relation(fields: [categoryId], references: [id])
  costs           ProductCost[]
  priceListItems  PriceListItem[]
  quotationItems  QuotationItem[]

  @@map("products")
}

/// Vigencias de costo por producto. La ausencia de solapamiento entre
/// vigencias se garantiza con un EXCLUDE constraint agregado a mano en
/// migration.sql (Prisma no expresa EXCLUDE), ver docs/ARCHITECTURE.md §5.3.
model ProductCost {
  id               String    @id @default(uuid()) @db.Uuid
  productId        String    @map("product_id") @db.Uuid
  purchaseCost     Decimal   @map("purchase_cost") @db.Decimal(12, 4)
  logisticsCost    Decimal   @default(0) @map("logistics_cost") @db.Decimal(12, 4)
  importExpenses   Decimal   @default(0) @map("import_expenses") @db.Decimal(12, 4)
  landedCost       Decimal   @map("landed_cost") @db.Decimal(12, 4)
  targetMarginPct  Decimal   @map("target_margin_pct") @db.Decimal(5, 2)
  minMarginPct     Decimal   @map("min_margin_pct") @db.Decimal(5, 2)
  effectiveFrom    DateTime  @default(now()) @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  createdAt        DateTime  @default(now()) @map("created_at")
  createdBy        String?   @map("created_by")

  product Product @relation(fields: [productId], references: [id])

  @@map("product_costs")
}

model PriceList {
  id             String    @id @default(uuid()) @db.Uuid
  businessUnitId String    @map("business_unit_id") @db.Uuid
  code           String    @unique
  name           String
  currency       Currency  @default(MXN)
  validFrom      DateTime  @default(now()) @map("valid_from")
  validTo        DateTime? @map("valid_to")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  businessUnit BusinessUnit    @relation(fields: [businessUnitId], references: [id])
  items        PriceListItem[]
  customers    Customer[]

  @@map("price_lists")
}

model PriceListItem {
  id           String   @id @default(uuid()) @db.Uuid
  priceListId  String   @map("price_list_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  listPrice    Decimal  @map("list_price") @db.Decimal(12, 2)
  specialPrice Decimal? @map("special_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  priceList PriceList @relation(fields: [priceListId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

// ---------------------------------------------------------------------------
// Modulo 4 (Clientes y contactos, alcance basico): ficha de cliente, sus
// direcciones y sus contactos. Ver docs/ARCHITECTURE.md §11.
// Alcance de RBAC: un Vendedor solo ve/crea clientes con assignedSellerId
// igual a si mismo ("no ver clientes de otros vendedores, salvo
// autorizacion" — brief §4); el resto de roles con permiso de ver clientes
// ve todos los de sus lineas de negocio asignadas (mismo patron que
// products.ts). Fuera de este alcance: documentos fiscales adjuntos,
// historial de cotizaciones/pedidos (no existen todavia esos modulos),
// reasignacion por Gerente de Ventas (solo lectura de sus lineas por ahora).
// ---------------------------------------------------------------------------

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum AddressType {
  FISCAL
  DELIVERY
}

enum DecisionPower {
  LOW
  MEDIUM
  HIGH
}

model PaymentTerms {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  creditDays Int      @default(0) @map("credit_days")
  createdAt  DateTime @default(now()) @map("created_at")

  customers Customer[]

  @@map("payment_terms")
}

model Customer {
  id                   String         @id @default(uuid()) @db.Uuid
  businessUnitId       String         @map("business_unit_id") @db.Uuid
  legalName            String         @map("legal_name")
  tradeName            String?        @map("trade_name")
  taxId                String?        @map("tax_id")
  industry             String?
  segment              String?
  assignedSellerId     String?        @map("assigned_seller_id") @db.Uuid
  paymentTermsId       String?        @map("payment_terms_id") @db.Uuid
  creditLimit          Decimal        @default(0) @map("credit_limit") @db.Decimal(12, 2)
  preferredCurrency    Currency       @default(MXN) @map("preferred_currency")
  priceListId          String?        @map("price_list_id") @db.Uuid
  authorizedDiscountPct Decimal       @default(0) @map("authorized_discount_pct") @db.Decimal(5, 2)
  notes                String?
  status               CustomerStatus @default(PROSPECT)
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  deletedAt            DateTime?      @map("deleted_at")

  businessUnit  BusinessUnit      @relation(fields: [businessUnitId], references: [id])
  assignedSeller User?            @relation(fields: [assignedSellerId], references: [id])
  paymentTerms  PaymentTerms?     @relation(fields: [paymentTermsId], references: [id])
  priceList     PriceList?        @relation(fields: [priceListId], references: [id])
  addresses     CustomerAddress[]
  contacts      Contact[]
  quotations    Quotation[]

  @@map("customers")
}

model CustomerAddress {
  id         String      @id @default(uuid()) @db.Uuid
  customerId String      @map("customer_id") @db.Uuid
  type       AddressType
  street     String
  city       String
  state      String
  zip        String
  country    String      @default("México")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, type])
  @@map("customer_addresses")
}

model Contact {
  id             String         @id @default(uuid()) @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  name           String
  position       String?
  area           String?
  email          String?
  phone          String?
  whatsapp       String?
  decisionPower  DecisionPower? @map("decision_power")
  preferences    String?
  lastContactAt  DateTime?      @map("last_contact_at")
  nextFollowupAt DateTime?      @map("next_followup_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Modulo 5 (Motor de folios). Ver docs/ARCHITECTURE.md §7. Cotizaciones y
// pedidos (modulos futuros) llaman a issueFolio() en la misma transaccion en
// la que crean el documento — el consecutivo nunca se incrementa "en falso"
// fuera de esa transaccion (docs/ARCHITECTURE.md §7.2).
// ---------------------------------------------------------------------------

enum DocumentType {
  QUOTATION
  ORDER
  CREDIT_NOTE
  DELIVERY_NOTE
}

/// Un renglon por (linea, tipo de documento, año). `year = 0` es el bucket
/// "continuo" usado cuando business_units.folio_numbering_mode = CONTINUOUS,
/// para no depender de NULL en la unique key (Postgres trata cada NULL como
/// distinto y permitiria filas duplicadas).
model SequenceSettings {
  id               String       @id @default(uuid()) @db.Uuid
  businessUnitId   String       @map("business_unit_id") @db.Uuid
  documentType     DocumentType @map("document_type")
  year             Int
  lastConsecutive  Int          @default(0) @map("last_consecutive")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id])

  @@unique([businessUnitId, documentType, year])
  @@map("sequence_settings")
}

// ---------------------------------------------------------------------------
// Modulo 6 (Cotizaciones, alcance nucleo). Ver docs/ARCHITECTURE.md §6/§8.
// El folio se emite dentro de la MISMA transaccion que crea la cotizacion
// (issueFolioInTransaction), al primer guardado — no antes, no despues
// (docs/ARCHITECTURE.md §7.4). Alcance de este modulo: crear, agregar
// partidas con precio resuelto automaticamente, calcular margen contra el
// motor ya construido (lib/catalog/margin.ts) y bloquear el envio si algun
// item queda por debajo de su margen minimo o excede el limite de descuento
// del vendedor. Fuera de este modulo: workflow de autorizacion con registro
// propio (quotation_approvals, Modulo 7), versionado tras el envio (Modulo 8)
// y PDF (Modulo 9) — hasta entonces, una cotizacion "Enviada" simplemente
// deja de ser editable.
// ---------------------------------------------------------------------------

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
  CONVERTED_TO_ORDER
}

model Quotation {
  id               String          @id @default(uuid()) @db.Uuid
  folio            String          @unique
  shortFolio       String          @map("short_folio")
  businessUnitId   String          @map("business_unit_id") @db.Uuid
  customerId       String          @map("customer_id") @db.Uuid
  sellerId         String          @map("seller_id") @db.Uuid
  currency         Currency        @default(MXN)
  status           QuotationStatus @default(DRAFT)
  validUntil       DateTime?       @map("valid_until")
  notes            String?
  subtotal         Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal    Decimal         @default(0) @map("discount_total") @db.Decimal(14, 2)
  total            Decimal         @default(0) @db.Decimal(14, 2)
  marginPct        Decimal?        @map("margin_pct") @db.Decimal(5, 2)
  requiresApproval Boolean         @default(false) @map("requires_approval")
  approvalReason   String?         @map("approval_reason")
  currentVersion   Int             @default(1) @map("current_version")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  businessUnit  BusinessUnit             @relation(fields: [businessUnitId], references: [id])
  customer      Customer                 @relation(fields: [customerId], references: [id])
  seller        User                     @relation(fields: [sellerId], references: [id])
  items         QuotationItem[]
  statusHistory QuotationStatusHistory[]
  approvals     QuotationApproval[]
  versions      QuotationVersion[]

  @@map("quotations")
}

model QuotationItem {
  id                   String   @id @default(uuid()) @db.Uuid
  quotationId          String   @map("quotation_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  description          String
  qty                  Int      @default(1)
  unitPrice            Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountPct          Decimal  @default(0) @map("discount_pct") @db.Decimal(5, 2)
  lineTotal            Decimal  @map("line_total") @db.Decimal(14, 2)
  landedCostSnapshot   Decimal? @map("landed_cost_snapshot") @db.Decimal(12, 4)
  minMarginPctSnapshot Decimal? @map("min_margin_pct_snapshot") @db.Decimal(5, 2)
  sortOrder            Int      @default(0) @map("sort_order")
  createdAt            DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

model QuotationStatusHistory {
  id           String           @id @default(uuid()) @db.Uuid
  quotationId  String           @map("quotation_id") @db.Uuid
  fromStatus   QuotationStatus? @map("from_status")
  toStatus     QuotationStatus  @map("to_status")
  changedById  String           @map("changed_by_id") @db.Uuid
  note         String?
  createdAt    DateTime         @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  changedBy User      @relation(fields: [changedById], references: [id])

  @@map("quotation_status_history")
}

// ---------------------------------------------------------------------------
// Modulo 7 (Autorizaciones). Ver docs/ARCHITECTURE.md §12. Cada envio de una
// cotizacion marcada `requiresApproval` crea un renglon aqui — es el
// registro de auditoria de la excepcion (quien la solicito, quien la
// decidio, cuando, con que margen). La autoridad requerida por regla vive en
// codigo (lib/quotations/approval-rules.ts), no en esta tabla, para poder
// probarla sin base de datos.
// ---------------------------------------------------------------------------

enum ApprovalRuleType {
  MARGIN_BELOW_MIN
  AMOUNT_OVER_THRESHOLD
  VALIDITY_OVER_30_DAYS
  DISCOUNT_OVER_LIMIT
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model QuotationApproval {
  id               String           @id @default(uuid()) @db.Uuid
  quotationId      String           @map("quotation_id") @db.Uuid
  ruleType         ApprovalRuleType @map("rule_type")
  reason           String
  requestedById    String           @map("requested_by_id") @db.Uuid
  requestedAt      DateTime         @default(now()) @map("requested_at")
  justification    String?
  approverId       String?          @map("approver_id") @db.Uuid
  decision         ApprovalDecision @default(PENDING)
  decidedAt        DateTime?        @map("decided_at")
  decisionNote     String?          @map("decision_note")
  marginPctBefore  Decimal?         @map("margin_pct_before") @db.Decimal(5, 2)

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("QuotationApprovalRequestedBy", fields: [requestedById], references: [id])
  approver    User?     @relation("QuotationApprovalApprover", fields: [approverId], references: [id])

  @@map("quotation_approvals")
}

// ---------------------------------------------------------------------------
// Modulo 8 (Versionado). Ver docs/ARCHITECTURE.md §7.3. Editar una
// cotizacion ya enviada (Super Admin/Administracion, permiso
// EDIT_APPROVED_QUOTATION) congela el estado *anterior* al cambio aqui
// antes de aplicarlo, y sube `quotations.current_version` — el folio raiz y
// el consecutivo nunca cambian, solo se le anexa el sufijo `-V{n}` (ver
// `lib/folio/format.ts`). Las versiones nunca se borran ni se editan.
// ---------------------------------------------------------------------------

model QuotationVersion {
  id            String   @id @default(uuid()) @db.Uuid
  quotationId   String   @map("quotation_id") @db.Uuid
  versionNumber Int      @map("version_number")
  snapshot      Json
  createdById   String   @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])

  @@unique([quotationId, versionNumber])
  @@map("quotation_versions")
}
