# Supabase — proyecto del ambiente (dev/staging/prod)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO se usa en servidor (lib/supabase/admin.ts). Nunca exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Anthropic) — usado exclusivamente en app/api/ai/**, nunca en el cliente.
ANTHROPIC_API_KEY=

# Empresa por defecto para desarrollo local (coincide con el seed de datos demo)
NEXT_PUBLIC_DEFAULT_COMPANY_SLUG=global-supplier-mty
