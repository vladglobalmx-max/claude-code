{
  "name": "@impulso/asset-library",
  "version": "0.1.0",
  "private": true,
  "description": "Asset Library oficial de Impulso Platform: almacenamiento de binarios de Asset (IndexedDB) + ingesta por tipo. Genérico sobre cualquier tipo de Asset del Document Schema, no solo imágenes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@impulso/document-schema": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.5",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
