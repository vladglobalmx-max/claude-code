{
  "name": "@impulso/sticker-builder",
  "version": "0.7.0",
  "private": true,
  "description": "Editor de Sticker Builder. Primer módulo construido sobre Impulso Engine + el Renderer Konva.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@impulso/asset-library": "workspace:*",
    "@impulso/document-schema": "workspace:*",
    "@impulso/engine": "workspace:*",
    "@impulso/export-engine": "workspace:*",
    "@impulso/project-library": "workspace:*",
    "@impulso/renderer-konva": "workspace:*",
    "@impulso/template-library": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@vitest/coverage-v8": "^2.0.5",
    "jsdom": "^25.0.1",
    "konva": "^9.3.14",
    "typescript": "^5.5.4",
    "vite": "^5.4.10",
    "vitest": "^2.0.5"
  }
}
