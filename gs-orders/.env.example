# Supabase — proyecto del ambiente (dev/staging/prod)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO se usa en servidor (lib/supabase/admin.ts). Nunca exponer con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# URL pública y estable del sitio (sin / al final). Usada como redirectTo de
# invitaciones, generateLink y restablecimiento de contraseña (ver
# src/lib/site-url.ts). Recomendada en producción para no depender de los
# headers de la petición; opcional en local. Ej: https://gs-orders.vercel.app
NEXT_PUBLIC_SITE_URL=
